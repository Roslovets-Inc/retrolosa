{
  "name": "retrolosa",
  "version": "1.0.0",
  "private": true,
  "description": "Explore Toulouse across historical maps and the present day.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "local": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prep": "bun run format && bun run lint:fix && bun run check",
    "verify": "bun run check && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
