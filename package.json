{
  "name": "toulouse-in-time",
  "version": "1.0.0",
  "private": true,
  "description": "Explore Toulouse across historical maps and the present day.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "project": "node scripts/project.mjs",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prep": "bun run format && bun run lint:fix && bun run check",
    "verify": "bun run check && bun run build && bun run test:e2e",
    "doctor": "node scripts/project.mjs doctor"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
